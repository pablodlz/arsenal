# target-substituted wordlists (the templates use <vendor>/<Object> placeholders)
wordlists/*.local.txt
wordlists/targets/

# raw output pulled off the testing host
*.log
*.har
*.jsonl
nuclei-output/
*.nuclei.json

# credentials / test-account tokens
.env
.env.*
!.env.example
*.pem
*.key
cookies.txt

